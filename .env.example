# Local default only; hosted frontend builds must use the reachable backend URL.
VITE_NOWCAST_API_URL=http://localhost:8000/api/v1
DATA_DIR=./data
MOSDAC_TIR_LOCAL_DIR=./data/mosdac
IMERG_MONTHLY_REGION_LABEL=UNVERIFIED - confirm shape in Giovanni
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Local account provisioning only. Never use a VITE_ prefix or commit this key.
SUPABASE_SERVICE_ROLE_KEY=

# Backend only. Never prefix this key with VITE_.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional provider feeds. Supply URLs only for products your deployment is authorized to access.
MOSDAC_TIR_GEOTIFF_URL=
MOSDAC_TIR_TILE_URL=
MOSDAC_TIR_BOUNDS=
IMD_RADAR_TILE_URL=
IMD_RADAR_WMS_LAYER=
IMD_RADAR_BOUNDS=
BLITZORTUNG_PROXY_URL=
